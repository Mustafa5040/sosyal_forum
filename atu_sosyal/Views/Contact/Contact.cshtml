@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "İletişim";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-body">İletişim</h1>
            </div>

            <div class="card shadow-lg border-0" style="overflow: hidden;">
                <div class="card-body p-5">

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success" style="border-radius:0 !important">
                            <strong>@ViewBag.Success</strong>
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" style="border-radius:0 !important">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post">

                        <div class="mb-4">
                            <label for="name" class="form-label fw-semibold">Adınız Soyadınız</label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   id="name"
                                   name="Name"
                                   placeholder="Örn: Ahmet Yılmaz"
                                   required>
                        </div>

                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">E-posta Adresiniz</label>
                            <input type="email"
                                   class="form-control form-control-lg"
                                   id="email"
                                   name="Email"
                                   placeholder="ornek@email.com"
                                   required>
                        </div>

                        <div class="mb-4">
                            <label for="message" class="form-label fw-semibold">Mesajınız</label>
                            <textarea class="form-control form-control-lg"
                                      id="message"
                                      name="Message"
                                      rows="3"
                                      placeholder="Mesajınızı buraya yazın..."
                                      required></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-success btn-lg fw-bold text-uppercase shadow-sm">
                                <i class="bi bi-send-fill me-2"></i>
                                Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">