@using atu_sosyal.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext _context

@{
    var sonEtkinlikler = _context.Events
                                 .OrderBy(x => x.Tarih)
                                 .Take(3)
                                 .ToList();
}

<div class="card shadow-sm mb-4">
    <h5 class="card-header fw-bold bg-transparent py-3" style="border-bottom: 1px solid var(--nv-border);">
        ETKİNLİKLER
    </h5>

    <div class="list-group list-group-flush">
        @if (sonEtkinlikler != null && sonEtkinlikler.Any())
        {
            @foreach (var item in sonEtkinlikler)
            {
                <a href="@Url.Action("Index", "Etkinlik")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start" style="background-color: transparent; border-color: var(--nv-border);">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold" style="color: var(--nv-text-primary);">@item.Baslik</div>
                        <small style="color: var(--nv-text-secondary); font-size: 0.85rem;">
                            <i class="bi bi-calendar-event me-1"></i> @item.Tarih.ToString("dd MMM HH:mm")
                            <br />
                            <i class="bi bi-geo-alt-fill me-1"></i> @item.Konum
                        </small>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="p-3 text-center" style="color: var(--nv-text-secondary);">
                Planlanmış etkinlik yok.
            </div>
        }
    </div>

    <div class="card-body p-2 border-top" style="border-color: var(--nv-border) !important;">
        <a href="@Url.Action("Olustur", "Etkinlik")" class="btn btn-sm btn-outline-success w-100 rounded-0">
            + Etkinlik Ekle
        </a>
    </div>
</div>