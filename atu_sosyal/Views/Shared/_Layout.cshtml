<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | ATÜ SOSYAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="icon" href="~/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/css/atu_style.css" asp-append-version="true">
</head>
<body>

    <nav id="vertical-navbar" class="d-none d-lg-flex flex-column p-3 position-fixed start-0 top-0 h-100" style="width: 260px; background: var(--bs-body-bg); z-index: 1000;">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand text-center mb-4 text-decoration-none">
            <div class="vstack gap-2 text-center align-items-center">
                <img src="~/images/logo.png" alt="Logo" width="72" height="72">
                <span class="fs-4 fw-bold" style="color: var(--nv-text-primary);">ATÜ SOSYAL</span>
            </div>
        </a>
        <hr class="text-secondary">

        @{
            var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
            bool showNewTopic = currentPath == "/" || currentPath.Contains("/home") || currentPath.Contains("/topic");
        }

        @if (User.Identity.IsAuthenticated)
        {
            @if (showNewTopic)
            {
                <button type="button" class="btn btn-success fw-bold text-uppercase mb-3 w-100" data-bs-toggle="modal" data-bs-target="#newTopicModal">
                    + Yeni Konu Aç
                </button>
            }
        }

        <a class="btn btn-light rounded-0 fw-bold text-uppercase mb-3 w-100 border-0"
           asp-controller="Contact"
           asp-action="Contact"
           style="color: #000 !important; background-color: #fff !important;">
            <i class="bi bi-envelope-fill me-1"></i> İletişim
        </a>

        <hr class="text-secondary">
        <h6 class="small text-uppercase mb-2" style="color: var(--nv-text-secondary);">Kategoriler</h6>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1"><a href="#" class="nav-link"><span class="small-badge me-2" style="background:#28a745;"></span>Linux</a></li>
            <li class="nav-item mb-1"><a href="#" class="nav-link"><span class="small-badge me-2" style="background:#0078D4;"></span>Windows</a></li>
            <li class="nav-item mb-1"><a href="#" class="nav-link"><span class="small-badge me-2" style="background:#FFD43B;"></span>Python</a></li>
            <li class="nav-item mb-1"><a href="#" class="nav-link"><span class="small-badge me-2" style="background:#DC3545;"></span>Donanım</a></li>
        </ul>

        <hr class="text-secondary">
        <a href="#" id="theme-toggle-btn" class="nav-link mb-2">
            <i class="bi bi-sun-fill me-2" id="theme-toggle-icon"></i>
            <span id="theme-toggle-text">Açık Mod</span>
        </a>

        <hr class="text-secondary">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="dropdown">
                <a href="#" class="nav-link d-flex align-items-center dropdown-toggle p-2"
                   id="userDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false"
                   style="color: var(--nv-text-primary); background: rgba(255,255,255,0.05);">

                    <img src="~/images/logo.png" alt="Profil" class="profile-pic-sm me-2" style="width:32px; height:32px;">
                    <strong class="text-truncate" style="max-width: 140px;">
                        @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)
                    </strong>
                </a>

                <ul class="dropdown-menu dropdown-menu-dark shadow rounded-0" aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person-gear me-2"></i> Profilim
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a class="btn btn-outline-light rounded-0 w-100" asp-controller="Account" asp-action="Login">
                Giriş Yap
            </a>
        }
    </nav>

    <nav class="navbar fixed-bottom navbar-dark d-lg-none border-top" style="background: var(--bs-body-bg);">
        <div class="container-fluid d-flex justify-content-around py-2">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-center">
                <i class="bi bi-house-door-fill fs-4"></i>
                <div class="small">Ana Sayfa</div>
            </a>
            <a href="#" data-bs-toggle="modal" data-bs-target="#searchModal" class="nav-link text-center">
                <i class="bi bi-search fs-4"></i>
                <div class="small">Ara</div>
            </a>
            @if (User.Identity.IsAuthenticated)
            {
                <a href="#" data-bs-toggle="modal" data-bs-target="#newTopicModal" class="nav-link text-center text-success">
                    <i class="bi bi-plus-square-fill fs-3"></i>
                    <div class="small">Yeni</div>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="nav-link text-center">
                    <i class="bi bi-person-fill fs-4"></i>
                    <div class="small">Profil</div>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="nav-link text-center">
                    <i class="bi bi-box-arrow-in-right fs-4"></i>
                    <div class="small">Giriş</div>
                </a>
            }
            <a href="#" id="theme-toggle-btn-mobile" class="nav-link text-center">
                <i class="bi bi-sun-fill fs-4" id="theme-toggle-icon-mobile"></i>
                <div class="small" id="theme-toggle-text-mobile">Tema</div>
            </a>
        </div>
    </nav>

    <div class="main-content">
        <div class="container py-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme_helper.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>