@model atu_sosyal.Models.User
@{
    ViewData["Title"] = "Giriş Yap / Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ATÜ Sosyal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/atu_style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>

    <div id="content-wrapper" class="d-flex flex-column min-vh-100">
        <div class="container flex-grow-1 d-flex align-items-center">
            <div class="row g-4 my-5 justify-content-center w-100">

                <main class="col-lg-10 col-md-12 col-11">

                    @if (ViewBag.SuccessRegister != null)
                    {
                        <div class="alert alert-success text-center">@ViewBag.SuccessRegister</div>
                    }
                    @if (ViewBag.ErrorRegister != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.ErrorRegister</div>
                    }
                    @if (ViewBag.ErrorLogin != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.ErrorLogin</div>
                    }

                    <div class="row g-4">

                        <div class="col-md-6">
                            <section id="signup">
                                <div class="card p-4 shadow h-100">
                                    <h5 class="card-title text-center fs-3">
                                        Kayıt Ol <i class="bi bi-person-plus-fill"></i>
                                    </h5>

                                    <form asp-action="Register" method="post">
                                        <div class="mb-3">
                                            <label asp-for="FullName" class="form-label">Ad Soyad</label>
                                            <input asp-for="FullName" class="form-control" placeholder="Adınızı ve soyadınızı giriniz..." />
                                            <span asp-validation-for="FullName" class="text-danger small"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                                            <input asp-for="Username" class="form-control" placeholder="Kullanıcı adınızı belirleyin..." />
                                            <span asp-validation-for="Username" class="text-danger small"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Phone" class="form-label">Telefon Numarası</label>
                                            <input asp-for="Phone" class="form-control" placeholder="Telefon numaranızı giriniz..." />
                                            <span asp-validation-for="Phone" class="text-danger small"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Password" class="form-label">Şifre</label>
                                            <input asp-for="Password" type="password" class="form-control" placeholder="Şifrenizi oluşturun..." />
                                            <span asp-validation-for="Password" class="text-danger small"></span>
                                        </div>

                                        <button type="submit" class="btn btn-success w-100 fw-bold fs-5">
                                            Kayıt Ol
                                        </button>
                                    </form>
                                </div>
                            </section>
                        </div>

                        <div class="col-md-6">
                            <section id="login">
                                <div class="card p-4 shadow h-100">
                                    <h5 class="card-title text-center fs-3">
                                        Giriş Yap <i class="bi bi-key-fill"></i>
                                    </h5>

                                    <form asp-action="LoginAuth" method="post">
                                        <div class="mb-3">
                                            <label class="form-label">Kullanıcı Adı</label>
                                            <input type="text" name="username" class="form-control" placeholder="Kullanıcı adınızı giriniz..." required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Şifre</label>
                                            <input type="password" name="password" class="form-control" placeholder="Şifrenizi giriniz..." required>
                                        </div>

                                        <button type="submit" class="btn btn-success w-100 fw-bold fs-5">
                                            Giriş Yap
                                        </button>
                                    </form>

                                </div>
                            </section>
                        </div>

                    </div>
                </main>
            </div>
        </div>

        <footer class="text-center py-3 mt-4 border-top" style="color: var(--nv-text-secondary); border-color: var(--nv-border) !important;">
            © 2025 ATÜ Sosyal - Tüm Hakları Saklıdır
        </footer>
    </div>
</body>
</html>