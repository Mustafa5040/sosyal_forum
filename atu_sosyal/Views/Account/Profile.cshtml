@using atu_sosyal.ViewModels
@model UserEditViewModel
@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="content-wrapper">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @ViewBag.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card shadow-sm rounded-0">
                    <div class="card-header bg-transparent border-bottom rounded-0 py-3">
                        <h4 class="mb-0 fw-bold text-warning">PROFİL BİLGİLERİM</h4>
                    </div>
                    <div class="card-body p-4">

                        <form asp-action="Profile" method="post">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="Username" /> <div class="mb-3">
                                <label class="form-label text-secondary">Kullanıcı Adı</label>
                                <input type="text" class="form-control rounded-0" value="@Model.Username" disabled />
                                <small class="text-muted">Kullanıcı adı değiştirilemez.</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label">Ad Soyad</label>
                                <input asp-for="FullName" class="form-control rounded-0" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">Telefon</label>
                                <input asp-for="Phone" class="form-control rounded-0" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <hr class="my-4" />

                            <h5 class="mb-3 text-white">Şifre İşlemleri</h5>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label">Yeni Şifre (Değiştirmek istemiyorsanız boş bırakın)</label>
                                <input asp-for="NewPassword" type="password" class="form-control rounded-0" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="CurrentPassword" class="form-label text-warning">Değişiklikleri Kaydetmek İçin Mevcut Şifre</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control rounded-0 border-warning" required />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success rounded-0 py-2 fw-bold">BİLGİLERİ GÜNCELLE</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm rounded-0 mt-4 border-danger">
                    <div class="card-body p-4">
                        <h5 class="text-danger fw-bold">Tehlikeli Bölge</h5>
                        <p class="text-secondary mb-3">Hesabınızı sildiğinizde açtığınız tüm konular ve veriler kalıcı olarak silinecektir. Bu işlem geri alınamaz.</p>

                        <form asp-action="DeleteAccount" method="post" onsubmit="return confirm('Hesabınızı kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz!');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger rounded-0 w-100">
                                <i class="bi bi-trash"></i> HESABIMI SİL
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>