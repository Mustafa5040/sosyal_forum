@using atu_sosyal.ViewModels
@model List<TopicViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ana Sayfa";
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATÜ SOSYAL</title>
</head>

<body>
    <div id="content-wrapper">
        <div class="container">
            <div class="d-flex align-items-center my-4 position-relative">
                <h1 id="main-page-title" class="fw-light w-100 text-center mb-0">SON KONULAR</h1>
                <button class="btn btn-primary position-absolute end-0" data-bs-toggle="modal" data-bs-target="#newTopicModal">
                    + Konu Aç
                </button>
            </div>

            <div class="row g-4">
                <main class="col-lg-8">
                    <div class="d-flex flex-column gap-3">

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var topic in Model)
                            {
                                <div class="card card-topic">
                                    <div class="card-body">
                                        <span class="badge bg-warning mb-2">@topic.Category</span>
                                        <h5 class="card-title mb-1">
                                            <a href="@Url.Action("Topic", "Topic", new { topicId = topic.topicId })" class="stretched-link text-decoration-none">
                                                @topic.Title
                                            </a>
                                        </h5>
                                        <small class="text-body-secondary d-block mb-3">
                                            @topic.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="profile-pic-sm bg-secondary rounded-circle d-flex justify-content-center align-items-center text-white">
                                                @topic.user.Username.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="fw-bold small">@topic.user.Username</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">Henüz hiç konu açılmamış. İlk konuyu sen aç!</div>
                        }

                    </div>
                </main>

                <aside class="col-lg-4">
                    <div class="d-flex flex-column gap-4">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="card shadow-sm mb-0">
                                <h5 class="card-header fw-bold bg-transparent py-3"
                                    style="border-bottom: 1px solid var(--nv-border); color: var(--nv-text-primary);">
                                    <i class="bi bi-sliders me-2"></i> YÖNETİM
                                </h5>

                                <div class="card-body">
                                    <a asp-controller="Topic" asp-action="RecentComments"
                                       class="btn btn-sm btn-outline-success w-100 rounded-0 fw-bold">
                                        <i class="bi bi-table me-2"></i> TÜM YORUMLAR
                                    </a>
                                </div>
                            </div>
                        }
                        <partial name="_EtkinlikWidget" />

                    </div>
                </aside>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newTopicModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Konu Oluştur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>



                <form asp-controller="Topic" asp-action="CreateTopic" method="post">
                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">Konu Başlığı</label>
                            <input type="text" name="Title" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Kategori</label>
                            <input type="text" name="Category" class="form-control" placeholder="Örn: Yazılım" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Konu İçeriği</label>
                            <textarea name="Content" class="form-control" rows="5" required></textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Oluştur</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>